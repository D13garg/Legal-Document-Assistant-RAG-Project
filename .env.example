# DEVELOPMENT-ONLY placeholders for the local headless slice (ADR-043/044/045). Copy to a file that
# is NOT committed and load it into your shell yourself; nothing in the repo reads a .env file.
# Every value below is a throwaway placeholder, never a real secret. Convention: LDA_<SECTION>__<FIELD>.

# --- runtime database role (the role `apps.provision` creates; NOT the admin) -------------------
LDA_DATABASE__URL=postgresql+psycopg://lda_app:change-me-dev-only@localhost:5432/lda
# --- admin URL: read ONLY by `python -m apps.provision` ----------------------------------------
LDA_PROVISIONING__ADMIN_URL=postgresql+psycopg://lda_admin:lda_dev_only@localhost:5432/lda

# --- shared object store (MinIO from docker/docker-compose.yml) --------------------------------
LDA_OBJECT_STORAGE__BUCKET=lda-dev-documents
LDA_OBJECT_STORAGE__ENDPOINT_URL=http://127.0.0.1:9000
LDA_OBJECT_STORAGE__ACCESS_KEY_ID=lda_dev_minio
LDA_OBJECT_STORAGE__SECRET_ACCESS_KEY=lda_dev_only_minio_secret

# --- platform --------------------------------------------------------------------------------
# single-quoted so a POSIX shell keeps the JSON (with its spaces) as ONE value
LDA_JOBS__QUEUES='{"documents": 1, "events": 1, "ingestion": 1}'
LDA_ACCESS_CONTROL__PROOF_KEY_ID=primary
# base64url (no padding) of at least 32 random bytes; generate your own, e.g.:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
LDA_ACCESS_CONTROL__PROOF_KEY=
LDA_GROUNDED_GENERATION__MODEL=development-extractive

# --- development guard and operator (ADR-043, ADR-045); absent or different => refuses ---------
LDA_DEVELOPMENT__ENVIRONMENT=development
LDA_DEV_OPERATOR__ENVIRONMENT=development
LDA_DEV_OPERATOR__TENANT_ID=00000000-0000-0000-0000-0000000d3501
# LDA_DEV_OPERATOR__PRINCIPAL_ID=   (printed by `python -m apps.dev_bootstrap` on first run)

# --- adapter set: the only registered name is `development` (ADR-045); needs the guard above -----
LDA_WORKER__ADAPTER_SET=development
# optional: LDA_DEV_SLICE__TIMEOUT_SECONDS=60  LDA_DEV_SLICE__POLL_SECONDS=0.5
