# ---- Secrets and local configuration (NEVER commit these) ----
# .env.example is the only environment file that belongs in git.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*

# ---- Python environments and caches ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- Tool caches (regenerated by the project's own gates) ----
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/

# ---- Test and coverage output ----
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---- Logs and scratch ----
*.log

# ---- Editors and operating system ----
.DS_Store
.vscode/
.idea/

# ---- Checkpoint archives and scratch bundles ----
*.zip